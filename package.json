{
  "name": "mangumi",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @mangumi/member dev",
    "build": "pnpm --filter @mangumi/member build",
    "build:pages": "node scripts/build-pages.mjs",
    "build:live": "node scripts/build-live.mjs",
    "start:live": "pnpm --filter @mangumi/api start",
    "test:api": "pnpm --filter @mangumi/api test",
    "test:security": "node --test scripts/security.test.mjs",
    "test:native": "pnpm --filter @mangumi/api exec tsx --test ../../apps/native/tests/*.test.ts",
    "build:native": "pnpm --filter @mangumi/native build",
    "test:load": "pnpm --filter @mangumi/api exec tsx tests/load.ts",
    "generate:client": "pnpm --filter @mangumi/api openapi && node scripts/generate-client.mjs",
    "test:live": "pnpm --filter @mangumi/member exec playwright test --config playwright.live.config.ts",
    "typecheck:api": "pnpm --filter @mangumi/api typecheck",
    "typecheck": "pnpm --filter @mangumi/member typecheck",
    "test": "pnpm --filter @mangumi/member test",
    "test:e2e": "pnpm --filter @mangumi/member test:e2e",
    "test:pages": "pnpm --filter @mangumi/member exec playwright test --config playwright.pages.config.ts",
    "preview": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
