# Copy to .env for the API. Never put provider secrets in EXPO_PUBLIC_* variables.
NODE_ENV=development
APP_ORIGIN=http://localhost:3001
PORT=3001
WEB_ROOT=../member/dist-live
SQLITE_PATH=.local/mangumi.sqlite
UPLOAD_DIR=.local/uploads
# Production: mysql://mangumi:password@db:3306/mangumi
DATABASE_URL=
# Generate with pnpm --filter @mangumi/api keys. Keep this key across restarts.
ENCRYPTION_KEY=
# Separate 32-byte base64 key for authenticated encrypted backups. Store elsewhere.
BACKUP_KEY=
SMTP_URL=
MAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Native store verification (server only). Do not enable billing before sandbox acceptance.
EXPO_ACCESS_TOKEN=
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_APP_ID=
APPLE_ENVIRONMENT=Production
# Semicolon-separated paths to trusted Apple root certificates, mounted read-only.
APPLE_ROOT_CERTIFICATES=
GOOGLE_PLAY_PACKAGE=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-play.json
GOOGLE_NOTIFICATION_AUDIENCE=
GOOGLE_NOTIFICATION_EMAIL=
# Comma-separated SHA-256 signing certificate fingerprints, colon-separated hex.
ANDROID_CERT_SHA256=
APP_DOMAIN=
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
# Set only while running admin:create; remove afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
